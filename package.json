{
  "name": "pantry-daily-puzzle",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "generate": "node scripts/generate-puzzles.mjs",
    "validate": "node scripts/validate-puzzles.mjs",
    "test": "node --test tests/*.test.mjs",
    "build": "node scripts/build.mjs",
    "check": "npm run build && npm test && npm run verify:v3",
    "dev": "node scripts/dev-server.mjs",
    "verify:v3": "node scripts/verify-v3.mjs",
    "test:browser": "playwright test"
  },
  "engines": {
    "node": "22.x"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1"
  }
}
