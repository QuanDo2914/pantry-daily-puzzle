{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": { "api/*.js": { "includeFiles": "{proposals/content-expansion/quality-v3/**,content/**}" } },
  "headers": [
    { "source": "/(.*)", "headers": [
      { "key": "X-Content-Type-Options", "value": "nosniff" },
      { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
      { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'" }
    ]},
    { "source": "/sw.js", "headers": [{ "key": "Cache-Control", "value": "no-store" }] }
  ],
  "crons": [{ "path": "/api/health", "schedule": "15 0 * * *" }]
}
